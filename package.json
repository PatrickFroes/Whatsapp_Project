{
  "name": "whatsapp-broker",
  "version": "2.0.0",
  "description": "Broker WhatsApp Business Cloud API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "setup": "npm install && npx prisma generate && npx prisma migrate deploy",
    "postinstall": "prisma generate",
    "db:studio": "npx prisma studio",
    "db:migrate": "npx prisma migrate deploy",
    "db:reset": "npx prisma migrate reset",
    "db:seed": "node scripts/create_super_admin.js",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "lint": "eslint src/ --max-warnings 10",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --colors",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "quality": "npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.13.4",
    "bcryptjs": "^3.0.3",
    "body-parser": "^1.20.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.2",
    "form-data": "^4.0.5",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "nodemailer": "^6.9.13",
    "redis": "^5.10.0",
    "socket.io": "^4.8.3",
    "zod": "^3.22.4"
  },
  "overrides": {
    "socket.io-parser": "^4.2.6",
    "path-to-regexp": "0.1.13"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "prisma": "^5.22.0",
    "supertest": "^6.3.3"
  }
}
