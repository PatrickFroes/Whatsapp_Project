# Server Configuration
PORT=3001
NODE_ENV=development
# Em produção, use: NODE_ENV=production

# ⚠️ IMPORTANT: WhatsApp Credentials Management
# DO NOT set WHATSAPP_TOKEN, PHONE_NUMBER_ID, META_APP_SECRET, or VERIFY_TOKEN here!
# Each tenant manages its own credentials via the Configuration table (admin panel)
# This ensures complete multi-tenant isolation and per-tenant credential security

# Database
# For PostgreSQL (Production) - Use credenciais fortes!
DATABASE_URL="postgresql://postgres_admin:ChangeMeToStrongPassword123!@#@localhost:5432/whatsapp_broker?schema=public"

# Redis Configuration (for Socket.io scaling)
# Em produção, use Redis com senha
REDIS_URL=redis://localhost:6379
# Para Redis com senha: redis://:SuaSenhaForte@localhost:6379

# CORS Configuration (comma-separated origins)
# Em produção, liste apenas seus domínios
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Docker Compose Credentials (override defaults)
POSTGRES_USER=postgres_admin
POSTGRES_PASSWORD=ChangeMeToStrongPassword123!@#
POSTGRES_DB=whatsapp_broker
REDIS_PASSWORD=ChangeMeToStrongRedisPassword456!@#
PGADMIN_EMAIL=admin@localhost.local
PGADMIN_PASSWORD=ChangeMeToPgAdminPassword789!@#

# Security
# IMPORTANT: Generate a strong secret key for production!
# Example: openssl rand -base64 32
# NEVER commit the .env file with real secrets!
JWT_SECRET=CHANGE_ME_TO_STRONG_SECRET_KEY_IN_PRODUCTION

# Optional: App Secret for additional security
APP_SECRET=your_app_secret_here

